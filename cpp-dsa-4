class Solution {
public:
    vector<int> plusOne(vector<int>& digits) {
        
        int n = digits.size();

        for(int i = n-1; i >= 0; i--)
        {
            if(digits[i] < 9)
            {
                digits[i]++;     // add 1
                return digits;   // done
            }
            digits[i] = 0;       // carry
        }

        // if all were 9 → add 1 at front
        digits.insert(digits.begin(), 1);
        return digits;
    }
};
